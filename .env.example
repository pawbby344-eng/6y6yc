# Токен бота от @BotFather — обязателен для `python -m mp_parser bot`
TG_BOT_TOKEN=

# Регион доставки Wildberries (влияет на цены и наличие).
# -1257786 Москва, -1123300 СПб, 12358062 Екатеринбург, 123585487 Новосибирск
WB_DEST=-1257786

# Сколько позиций показывать по каждому источнику и максимум по кнопке «Ещё»
DEFAULT_LIMIT=5
MAX_LIMIT=30

# Ozon: пускать Chromium, если прямой запрос словил анти-бота
OZON_USE_BROWSER=true
# Путь к бинарнику Chromium, если Playwright не находит его сам
OZON_BROWSER_PATH=
# Ozon умеет распознавать headless-браузер. Если выдача пустая, поставь false —
# откроется настоящее окно Chromium, это заметно повышает шансы
OZON_HEADLESS=true

REQUEST_TIMEOUT=20
RETRIES=3
RETRY_BACKOFF=1.0

# Сколько секунд живёт запрос под кнопками выдачи
CACHE_TTL=600
